{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": false,
    "skipLibCheck": false,
    "baseUrl": ".",
    "paths": {
      "@*": ["src/*"]
    },
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strictNullChecks": true
  },
  "exclude": ["dist", "node_modules"]
}
