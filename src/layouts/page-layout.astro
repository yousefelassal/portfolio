---
import "@styles/global.css"
import BaseHead from "@components/base-head.astro"
import Header from "@components/header.astro"
import Footer from "@components/footer.astro"
import Drawer from "@components/drawer.astro"
import { buildPageTitle } from "@lib/seo"
import type { SeoProps } from "@lib/seo"

type Props = SeoProps

const { title, ...seoProps } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={buildPageTitle(title)} {...seoProps} />
    <script type="text/javascript">
      ((c, l, a, r, i) => {
        c[a] ||= (...args) => {
          (c[a].q ||= []).push(args)
        }
        const script = l.createElement(r)
        script.async = 1
        script.src = `https://www.clarity.ms/tag/${i}`
        const [firstScript] = l.querySelectorAll(r)
        firstScript.parentNode.insertBefore(script, firstScript)
      })(window, document, "clarity", "script", "ud27oxweux")
    </script>
  </head>
  <body>
    <Header />
    <Drawer />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
